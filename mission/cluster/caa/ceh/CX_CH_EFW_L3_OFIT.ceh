START_META     =   DATASET_TYPE
   ENTRY       =   "Support_Data"
END_META       =   DATASET_TYPE
START_META     =   DATASET_DESCRIPTION
   ENTRY       =   "This dataset contains spinfits of the electric field done"
   ENTRY       =   "onboard from either probe pair p12 or p34 and transmitted"
   ENTRY       =   "in the housekeeping telemetry (5.15 sec resolution,"
   ENTRY       =   "every point corresponds to a fit of 4 sec long interval)"
   ENTRY       =   "from the EFW experiment on the Cluster CXXX spacecraft"
   ENTRY       =   "The probe pair used for the onboard fit is indicated by"
   ENTRY       =   "the variable Probe_pair. The individual probe potential"
   ENTRY       =   "of one single probe (1 or 3) is also given as P13."
END_META       =   DATASET_DESCRIPTION
START_META     =   DATASET_CAVEATS
   ENTRY       =   "The electric field is not corrected for the ISR2 offsets"
   ENTRY       =   "and not validated. Please use CXXX_CP_EFW_L3_E if you"
   ENTRY       =   "need data of scientific quality"
END_META       =   DATASET_CAVEATS
START_META     =   TIME_RESOLUTION
   ENTRY       =   5.15
END_META       =   TIME_RESOLUTION
START_META     =   MIN_TIME_RESOLUTION
   ENTRY       =   5.15
END_META       =   MIN_TIME_RESOLUTION
START_META     =   MAX_TIME_RESOLUTION
   ENTRY       =   5.15
END_META       =   MAX_TIME_RESOLUTION
START_META     =   PROCESSING_LEVEL
   ENTRY       =   "Calibrated"
END_META       =   PROCESSING_LEVEL

START_META     =   CONTACT_COORDINATES
   ENTRY       =   "Yuri Khotyaintsev>PI>Yuri.Khotyaintsev@irfu.se"
END_META       =   CONTACT_COORDINATES
!
