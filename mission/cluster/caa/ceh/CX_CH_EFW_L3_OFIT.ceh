START_META     =   DATASET_TITLE
   ENTRY       =   "Onboard spinfits transmitted in housekeeping data (5.15 sec resolution)"
END_META       =   DATASET_TITLE
START_META     =   DATASET_TIME_SPAN
   VALUE_TYPE  =   ISO_TIME_RANGE
