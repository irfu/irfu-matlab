!

START_META     =   OBSERVATORY
    ENTRY      =   "Cluster-4"
END_META       =   OBSERVATORY

START_META     =   OBSERVATORY_CAVEATS
    ENTRY      =   "*C4_CQ"
    ENTRY = "Main planned commissioning events : "
    ENTRY = " - 2000-08-09T11:13Z/2000-08-09T11:13Z :  Launch 2"
    ENTRY = " - 2000-08-09T11:13Z/2000-11-02T19:45Z :  SC not at 15 rpm"
    ENTRY = " - 2000-08-16T09:00Z/2000-08-16T13:00Z :  ASPOC+CIS cover opening and FGM"
    ENTRY = " - 2000-08-24T15:30Z/2000-08-24T20:30Z :  FGM Switch-on + tests"
    ENTRY = " - 2000-10-23T17:48Z/2000-10-23T18:48Z :  WEC First full WEC on (A.4)"
    ENTRY = " - 2000-10-25T16:15Z/2000-10-25T17:15Z :  WEC Deploy booms 3 & 4 and  to 15 m (B.3)"
    ENTRY = " - 2000-10-25T17:15Z/2000-10-25T18:15Z :  WEC Deploy booms 1 & 2 from 1.3 m to 15 m (B.4)"
    ENTRY = " - 2000-10-25T18:15Z/2000-10-25T18:55Z :  WEC Spin up satellite to 22 rpm + sphere release (B.5)"
    ENTRY = " - 2000-11-02T16:22Z/2000-11-02T16:57Z :  WEC Deploy booms 3 & 4 from 35 m to 43 m (D.2)"
    ENTRY = " - 2000-11-16T14:15Z/2000-11-16T15:25Z :  WEC Deploy booms 1 & 2 from 20 m to 43 m (E.2)"
    ENTRY = " - 2000-12-06T11:00Z/2000-12-20T18:30Z :  Interferences + Intercalibration (6 orbits)/ JSOC OBRQ"
END_META       =   OBSERVATORY_CAVEATS

START_META     = OBSERVATORY_DESCRIPTION  
    ENTRY      = "Cluster-4 (Tango)"
    ENTRY      = "Launched: 9 Aug 2000"
    ENTRY      = "ESA Number: 4"
    ENTRY      = "COSPAR ID: 2000-045B"
    ENTRY      = "USSPACECOM catalogue number: 26464"
    ENTRY      = "CSDS Code: C4"
    ENTRY      = "ESOC FD code: S4"
    ENTRY      = "ESA Flight Model Number: FM8"
END_META       = OBSERVATORY_DESCRIPTION 

START_META     = OBSERVATORY_TIME_SPAN
    VALUE_TYPE = ISO_TIME_RANGE
    ENTRY      = 2000-07-16T00:00:00Z/2026-09-01T00:00:00Z
END_META       = OBSERVATORY_TIME_SPAN

START_META     = OBSERVATORY_REGION 
    ENTRY      = "Solar_Wind" 
    ENTRY      = "Bow_Shock" 
    ENTRY      = "Magnetosheath" 
    ENTRY      = "Magnetopause" 
    ENTRY      = "Magnetosphere" 
    ENTRY      = "Magnetotail" 
    ENTRY      = "Polar_Cap" 
    ENTRY      = "Auroral_Region" 
    ENTRY      = "Cusp" 
    ENTRY      = "Radiation_Belt"
    ENTRY      = "Plasmasphere" 
END_META       = OBSERVATORY_REGION

